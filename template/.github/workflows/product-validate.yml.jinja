# Product-as-code gate for {{ project_name }}. Fails the PR if any artifact is
# malformed, references a missing id, or if {{ output_bundle }} has drifted out of
# sync with {{ product_dir }}/. Run `fastpdlc build` locally and commit the result.
name: product-validate

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: tarvitave/fastpdlc@v{{ fastpdlc_version }}
        with:
          config: product.config.yaml

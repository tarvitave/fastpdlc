# fastpdlc.com — Caddy handles TLS certificates automatically via Let's Encrypt.
# Point the A/AAAA records at the server first; certificates are issued on boot.

{
	email {$ACME_EMAIL}
	# Uncomment while testing so you don't burn Let's Encrypt rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# www redirects to the apex so there is one canonical origin.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		# Sent on every response.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		X-Frame-Options           "SAMEORIGIN"
		Permissions-Policy        "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		-Server
	}

	# ── lead capture / future CRM endpoints ──────────────────────────────
	handle /api/* {
		reverse_proxy api:8000
	}

	# The admin panel. Server-rendered by the API; never cached, never indexed.
	handle /admin* {
		reverse_proxy api:8000
		header {
			Cache-Control "no-store"
			X-Robots-Tag  "noindex, nofollow"
		}
	}


	# ── markdown for agents (acceptmarkdown.com) ─────────────────────────
	# An agent reading the HTML gets ~26% signal and ~74% chrome. Every page has
	# a .md rendition beside it; this serves that when markdown is asked for.
	#
	# `Vary: Accept` is not optional here: without it a CDN will hand the cached
	# HTML to an agent asking for markdown, or the reverse, depending on which
	# variant landed in the cache first.
	@markdown header Accept *text/markdown*
	handle @markdown {
		root * /srv
		header Content-Type "text/markdown; charset=utf-8"
		header >Vary "Accept, Accept-Encoding"
		header Cache-Control "public, max-age=300, must-revalidate"
		try_files {path}.md {path}index.md {path}/index.md {path}
		file_server
	}

	# ── the static site ──────────────────────────────────────────────────
	handle {
		root * /srv
		# Declared on the HTML branch too, so a cache keyed on this header knows
		# both representations exist.
		header >Vary "Accept, Accept-Encoding"

		# Fingerprinted assets could be cached forever; these aren't, so keep
		# it short enough that a deploy is visible within the hour.
		@assets path *.css *.js *.svg *.png *.woff2
		header @assets Cache-Control "public, max-age=3600, must-revalidate"
		header /index.html Cache-Control "public, max-age=300, must-revalidate"

		try_files {path} {path}/ {path}.html
		file_server
	}

	handle_errors {
		@404md expression {err.status_code} == 404
		@wants_md header Accept *text/markdown*
		rewrite @404md /404.html
		# an agent that asked for markdown gets a markdown 404 body it can act on
		rewrite @wants_md /404.md

		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server {
			root /srv
		}
	}
}

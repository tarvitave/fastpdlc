# Copy to .env on the server and fill in. Never commit .env.
#
#   cp .env.example .env && chmod 600 .env

SITE_DOMAIN=fastpdlc.com
ACME_EMAIL=you@example.com

# Bearer token for GET /api/leads.csv — generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Salt for hashing IPs in the rate limiter — generate with: openssl rand -hex 16
IP_SALT=


# ── admin panel ────────────────────────────────────────────────────────────
ADMIN_USER=admin
# bcrypt hash. Generate with:
#   docker compose run --rm --no-deps --entrypoint python api auth.py 'yourpassword'
ADMIN_PASSWORD_HASH=
# Signing key for the admin session cookie: openssl rand -hex 32
SESSION_SECRET=

# ── newsletter ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
POSTMARK_TOKEN=
NEWSLETTER_FROM=marketing@fastpdlc.com
# THE KILL SWITCH. "on" sends generated issues to every subscriber automatically,
# twice a week, with no human review. "off" still generates drafts for you to send.
NEWSLETTER_AUTOSEND=off
NEWSLETTER_MAX_RECIPIENTS=2000

# ── seo ────────────────────────────────────────────────────────────────────
# Daily audit at 03:00 UTC. "on" applies safe metadata fixes automatically.
SEO_AUTOFIX=on
